# CI Engine Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# REQUIRED - Generate these with: ./scripts/generate-secrets.sh
# =============================================================================

# Fernet key for encrypting secrets (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
CI_ENGINE_FERNET_KEY=

# JWT secret for authentication (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
CI_ENGINE_JWT_SECRET_KEY=

# =============================================================================
# DATABASE - PostgreSQL
# =============================================================================

DATABASE_URL=postgresql://ci_engine:CHANGEME@db:5432/ci_engine

# Or individual components:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=ci_engine
# POSTGRES_PASSWORD=CHANGEME
# POSTGRES_DB=ci_engine

# =============================================================================
# REDIS
# =============================================================================

REDIS_URL=redis://:CHANGEME@redis:6379/0

# Or individual components:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=CHANGEME

# =============================================================================
# AWS - For S3 artifacts and remote cache
# =============================================================================

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CI_ENGINE_S3_BUCKET=ci-engine-artifacts

# Optional - S3-compatible endpoint (MinIO, etc.)
# S3_ENDPOINT_URL=https://s3.amazonaws.com

# =============================================================================
# NOTIFICATIONS - Optional
# =============================================================================

# Slack webhook (get from Slack app settings)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/XXX/XXX

# Discord webhook
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXX/XXX

# Email (SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=CHANGEME
# EMAIL_FROM=ci-engine@yourdomain.com
# EMAIL_TO=alerts@yourdomain.com

# =============================================================================
# OIDC - For cloud provider authentication (optional)
# =============================================================================

# AWS OIDC
# AWS_OIDC_ISSUER=https://oidc.eks.us-east-1.amazonaws.com/id/XXX
# AWS_OIDC_CLIENT_ID=ci-engine
# AWS_OIDC_CLIENT_SECRET=

# =============================================================================
# LOGGING
# =============================================================================

LOG_LEVEL=info
LOG_FORMAT=json

# =============================================================================
# SECURITY
# =============================================================================

# CORS origins (comma-separated)
CORS_ORIGINS=*

# Rate limiting
# RATE_LIMIT_PER_MINUTE=100

# =============================================================================
# AGENT CONFIGURATION
# =============================================================================

CI_SERVER_URL=http://server:8000
CI_WORKSPACE=/workspace
CI_CONTAINER_RUNTIME=docker
CI_ENGINE_DEFAULT_IMAGE=ubuntu:22.04

# =============================================================================
# OPENTELEMETRY - Optional
# =============================================================================

# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_SERVICE_NAME=ci-engine-server
