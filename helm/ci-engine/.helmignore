# SPDX-License-Identifier: MIT
# CI Engine - .helmignore

# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.bzr/
.bzrignore
.git/
.gitignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# Build files
*.tar.gz
*.tgz
# CI files
.github/
tests/
ci_engine/
*.md
# Local data
ci_engine.db
.coverage
.pytest_cache/
.ruff_cache/
venv/
.venv/